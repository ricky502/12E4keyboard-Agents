{
  "manifest_version": 3,
  "name": "Agentpad Playback Adapter",
  "version": "1.0.0",
  "description": "Maps Agentpad speed keys to the active YouTube or Bilibili HTML5 video.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
